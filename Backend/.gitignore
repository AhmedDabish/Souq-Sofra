# ==========================================
# Backend .gitignore - .NET 8 / C# / EF Core
# ==========================================

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
out/
dist/

# Visual Studio cache and user files
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Mono / Rider / VS Code
.idea/
.ionide/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# User-specific developer secrets
usersecrets/
secrets.json

# Crash dumps & memory traces
*.stackdump
*.dmp
*.crashdump

# Publish output
publish/
PublishOutput/
*.pubxml
*.publishsettings

# OS Files
.DS_Store
Thumbs.db
