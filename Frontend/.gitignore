# ==========================================
# Frontend .gitignore - Angular 18
# ==========================================

# Dependencies
node_modules/
.npm/
package-lock.json.lock

# Angular Cache & Builds
.angular/
dist/
out-tsc/
bazel-out/

# Testing & Coverage
coverage/
.nyc_output/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS Files
.DS_Store
Thumbs.db
