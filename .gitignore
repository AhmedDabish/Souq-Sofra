# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Environment & Secrets
.env
.env.local
.env.*.local
*.pfx
*.publishsettings

# Log Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / Frontend Artifacts
**/node_modules/
**/dist/
**/.angular/
**/.npm/

# .NET / Backend Artifacts
**/bin/
**/obj/
**/out/
**/[Bb]in/
**/[Oo]bj/
**/.vs/
**/*.user
**/*.userosscache
**/*.suo
**/*.sln.docstates
**/TestResults/

# IDE / Editors
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Runtime API diagnostics (daily JSONL files)
/Backend/SouqSofra.API/Logs/
